<section class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-black uppercase tracking-normal text-[#1E5A7A]">Security</p>
      <h1 class="mt-2 text-3xl font-black tracking-normal">Active Sessions</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Browsers and devices currently signed in to your account.</p>
    </div>

    <% if @active_sessions.many? %>
      <%= button_to "Sign out other sessions", other_active_sessions_path, method: :delete,
        class: primary_button_class %>
    <% end %>
  </div>

  <div class="space-y-3">
    <% @active_sessions.each do |active_session| %>
      <article class="<%= app_card_class("p-5") %>">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-black"><%= session_device_description(active_session) %></h2>
              <% if active_session == Current.session %>
                <%= status_chip("Current session", tone: :success) %>
              <% end %>
            </div>
            <dl class="mt-3 grid gap-2 text-sm text-slate-600 sm:grid-cols-2 sm:gap-x-8">
              <div>
                <dt class="font-semibold">Signed in</dt>
                <dd><%= l active_session.created_at, format: :long %></dd>
              </div>
              <div>
                <dt class="font-semibold">Recent activity</dt>
                <dd><%= l active_session.last_seen_at, format: :long %></dd>
              </div>
            </dl>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
