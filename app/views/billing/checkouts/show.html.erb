<% content_for :title, "Choose your plan | Boat Binder" %>

<section class="space-y-6">
  <header class="max-w-3xl">
    <p class="text-sm font-black uppercase text-[#1E5A7A]">Self Managed</p>
    <h1 class="mt-2 text-3xl font-black md:text-4xl">Choose your billing schedule</h1>
    <p class="mt-3 text-base leading-7 text-slate-600">Keep your vessel records, documents, reminders, and service history together.</p>
  </header>

  <% if @billing_account %>
    <div class="rounded-md border border-[#C9DEE2] bg-[#E8F3F5] px-4 py-3 text-sm text-[#0B1F35]">
      <span class="font-black">Account:</span> <%= @billing_account.name %>
    </div>
  <% end %>

  <% if @billing_options.any? %>
    <div class="grid gap-5 lg:grid-cols-2">
      <% @billing_options.each do |option| %>
        <article class="<%= app_card_class("flex flex-col p-6") %>">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-2xl font-black"><%= option.name %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= option.description %></p>
            </div>
            <% if option.trial? %>
              <%= status_chip("#{option.trial_days}-day trial", tone: :info) %>
            <% end %>
          </div>

          <p class="mt-6 text-4xl font-black"><%= option.display_price %></p>
          <ul class="mt-6 flex-1 space-y-3 text-sm font-semibold text-slate-700">
            <li>Unlimited vessel records</li>
            <li>Documents, reminders, and service history</li>
            <li>Payment details handled securely by Stripe</li>
          </ul>

          <%= button_to "Start #{option.interval == "year" ? "annual" : "monthly"} Checkout",
            billing_checkout_path,
            params: { option_key: option.key },
            class: primary_button_class("mt-7 w-full") %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="<%= app_card_class("p-6") %>">
      <h2 class="text-xl font-black">Checkout is temporarily unavailable.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Please try again shortly. Your current Boat Binder records and access have not changed.</p>
      <%= link_to "Return to dashboard", root_path, class: secondary_button_class("mt-5") %>
    </div>
  <% end %>
</section>
