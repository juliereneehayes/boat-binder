<% operating_fields = {
  engine_startup_instructions: "Engine startup instructions",
  engine_shutdown_instructions: "Engine shutdown instructions",
  battery_shore_power_instructions: "Battery and shore-power instructions",
  operating_notes: "Additional operating notes"
} %>

<section id="access-operations" class="space-y-5">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-black uppercase tracking-normal text-[#1E5A7A]">Vessel profile</p>
      <h2 class="mt-1 text-xl font-black">Access &amp; Operations</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
        Routine operating instructions are visible under normal Vessel permissions. Passwords, codes, physical
        key locations, and other sensitive access details belong only in Restricted Access below.
      </p>
    </div>
    <% if can_manage_vessel %>
      <%= link_to "Edit operating instructions", edit_vessel_path(vessel, anchor: "vessel-operations"), class: secondary_button_class("min-h-10 shrink-0") %>
    <% end %>
  </div>

  <div class="rounded-md border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-lg font-black">Vessel Operations</h3>
    <p class="mt-1 text-sm leading-6 text-slate-600">Ordinary instructions for safely starting, stopping, and caring for this Vessel.</p>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      <% operating_fields.each do |field, label| %>
        <div class="rounded-md bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-600"><%= label %></p>
          <p class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-slate-900"><%= vessel.public_send(field).presence || "Not set" %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-md border border-amber-200 bg-amber-50 p-5 shadow-sm">
    <div>
      <p class="text-sm font-black uppercase tracking-normal text-amber-800">Sensitive information</p>
      <h3 class="mt-1 text-lg font-black text-amber-950">Restricted Access</h3>
      <p class="mt-2 text-sm leading-6 text-amber-900">
        Values stay masked until an authorized user deliberately reveals one. Each reveal rechecks current access
        and is recorded without storing the value in the audit event.
      </p>
    </div>

    <% if @can_read_restricted_access %>
      <% VesselAccessInformation::RESTRICTED_FIELD_DEFINITIONS.group_by { |_field, definition| definition.fetch(:group) }.each do |group, fields| %>
        <div class="mt-5">
          <h4 class="font-black text-amber-950"><%= group %></h4>
          <div class="mt-3 grid gap-3 md:grid-cols-2">
            <% fields.each do |field, _definition| %>
              <%= render "restricted_field_state",
                vessel:,
                field:,
                present: @restricted_field_names.include?(field) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @can_write_restricted_access %>
        <%= form_with url: vessel_access_information_path(vessel), method: :patch, class: "mt-6 space-y-4" do %>
          <div class="border-t border-amber-200 pt-5">
            <h4 class="font-black text-amber-950">Replace or clear restricted values</h4>
            <p class="mt-1 text-sm leading-6 text-amber-900">
              Keep Existing is the default. Replacing a value never reveals the previous value. Clear removes only
              the selected field.
            </p>
          </div>

          <div class="grid gap-4 lg:grid-cols-2">
            <% VesselAccessInformation::RESTRICTED_FIELD_DEFINITIONS.each do |field, definition| %>
              <% operation_id = "restricted_fields_#{field}_operation" %>
              <% value_id = "restricted_fields_#{field}_value" %>
              <fieldset class="rounded-md border border-amber-200 bg-white p-4">
                <legend class="px-1 text-sm font-black text-slate-900"><%= definition.fetch(:label) %></legend>
                <div>
                  <%= label_tag operation_id, "Action", class: "text-sm font-semibold text-slate-700" %>
                  <%= select_tag "restricted_fields[#{field}][operation]",
                    options_for_select([ [ "Keep Existing", "keep" ], [ "Replace", "replace" ], [ "Clear", "clear" ] ]),
                    id: operation_id,
                    class: "mt-2 min-h-12 w-full rounded-md border border-slate-300 px-4 py-3 text-base" %>
                </div>
                <div class="mt-3">
                  <%= label_tag value_id, "New #{definition.fetch(:label).downcase}", class: "text-sm font-semibold text-slate-700" %>
                  <% if definition.fetch(:multiline) %>
                    <%= text_area_tag "restricted_fields[#{field}][value]", nil,
                      id: value_id,
                      rows: 3,
                      maxlength: definition.fetch(:maximum),
                      autocomplete: "off",
                      spellcheck: false,
                      class: "mt-2 w-full rounded-md border border-slate-300 px-4 py-3 text-base" %>
                  <% else %>
                    <%= password_field_tag "restricted_fields[#{field}][value]", nil,
                      id: value_id,
                      maxlength: definition.fetch(:maximum),
                      autocomplete: "new-password",
                      autocapitalize: "none",
                      spellcheck: false,
                      class: "mt-2 min-h-12 w-full rounded-md border border-slate-300 px-4 py-3 text-base" %>
                  <% end %>
                </div>
              </fieldset>
            <% end %>
          </div>

          <%= submit_tag "Save restricted access", class: "min-h-12 w-full rounded-md bg-amber-800 px-5 py-3 text-base font-black text-white shadow-sm sm:w-auto", data: { turbo_submits_with: "Saving…" } %>
        <% end %>
      <% else %>
        <p class="mt-5 rounded-md border border-amber-200 bg-white px-4 py-3 text-sm font-semibold text-amber-950">
          Your current access is read-only. You can reveal saved values but cannot replace or clear them.
        </p>
      <% end %>
    <% else %>
      <p class="mt-5 rounded-md border border-amber-200 bg-white px-4 py-3 text-sm font-semibold text-amber-950">
        Restricted access information is not available under your current Account relationship. Routine operating
        instructions above remain available under normal Vessel permissions.
      </p>
    <% end %>
  </div>
</section>
