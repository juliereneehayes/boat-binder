<%= turbo_frame_tag "restricted_access_#{field}",
  class: "block rounded-md border border-amber-300 bg-white p-4",
  data: {
    controller: "restricted-reveal",
    action: "turbo:before-cache@document->restricted-reveal#beforeCache pagehide@window->restricted-reveal#pageHide pageshow@window->restricted-reveal#pageShow"
  } do %>
  <template data-restricted-reveal-target="masked">
    <%= render "vessels/restricted_field_masked_content", vessel:, field:, present: true %>
  </template>
  <p class="text-sm font-semibold text-slate-600"><%= VesselAccessInformation::RESTRICTED_FIELD_DEFINITIONS.fetch(field).fetch(:label) %></p>
  <p class="mt-2 whitespace-pre-wrap break-words font-black text-slate-950" data-restricted-reveal-target="secret"><%= value %></p>
  <%= button_to "Hide",
    hide_vessel_access_information_path(vessel),
    params: { field: },
    class: "mt-3 min-h-10 rounded-md border border-slate-300 px-4 py-2 text-sm font-black text-slate-800",
    data: { turbo_submits_with: "Hiding…" } %>
<% end %>
