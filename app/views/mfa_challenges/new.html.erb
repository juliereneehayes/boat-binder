<section class="mx-auto max-w-md pt-10">
  <div class="mb-8">
    <p class="text-sm font-bold uppercase tracking-normal text-cyan-700">Two-factor authentication</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal text-slate-950">Verify your sign-in</h1>
    <p class="mt-2 text-sm leading-6 text-slate-600">Enter the six-digit code from your authenticator or password manager.</p>
  </div>

  <%= form_with url: mfa_challenge_path, scope: :mfa, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :code, "Verification code", class: "text-sm font-semibold text-slate-700" %>
      <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code",
        inputmode: "numeric", pattern: "[0-9 -]*", maxlength: 12,
        class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-lg tracking-widest shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
    </div>

    <%= form.submit "Verify and sign in", class: "min-h-12 w-full rounded-md bg-cyan-700 px-4 py-3 text-base font-bold text-white shadow-sm", data: { turbo_submits_with: "Verifying..." } %>
  <% end %>

  <details class="mt-8 rounded-md border border-slate-200 bg-white p-4">
    <summary class="cursor-pointer text-sm font-bold text-slate-700">Use a recovery code</summary>
    <%= form_with url: mfa_challenge_path, scope: :mfa, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :recovery_code, "Recovery code", class: "text-sm font-semibold text-slate-700" %>
        <%= form.text_field :recovery_code, required: true, autocomplete: "off", autocapitalize: "characters",
          class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 font-mono text-base uppercase shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
      </div>
      <%= form.submit "Use recovery code", class: secondary_button_class, data: { turbo_submits_with: "Verifying..." } %>
    <% end %>
  </details>

  <%= button_to "Cancel and sign out", mfa_challenge_path, method: :delete,
    class: "mt-6 block w-full py-2 text-center text-sm font-semibold text-slate-600 underline" %>
</section>
