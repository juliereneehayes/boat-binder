<% if flash[:registration_submitted] %>
  <section class="mx-auto max-w-md pt-10 text-center">
    <div class="mx-auto mb-6 flex justify-center">
      <%= render "shared/brand_mark", class_name: "h-16 w-16" %>
    </div>
    <p class="text-sm font-bold uppercase tracking-normal text-cyan-700">Account setup</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal text-slate-950">Check your email</h1>
    <p class="mt-4 text-base leading-7 text-slate-600"><%= RegistrationsController::CHECK_EMAIL_NOTICE %></p>
    <%= link_to "Return to sign in", new_session_path, class: "mt-6 inline-block py-2 text-sm font-semibold text-slate-600 underline" %>
  </section>
<% else %>
<section class="mx-auto max-w-md pt-10">
  <div class="mb-8">
    <p class="text-sm font-bold uppercase tracking-normal text-cyan-700">Self Managed</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal text-slate-950">Create your Boat Binder account</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600">Start with your contact details. Vessel and payment information come later.</p>
  </div>

  <% if @registration.errors.any? %>
    <div class="mb-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-bold">Please check the form.</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @registration.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @registration, scope: :registration, url: registration_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :name, "Name", class: "text-sm font-semibold text-slate-700" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 120, class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
    </div>

    <div>
      <%= form.label :email_address, "Email", class: "text-sm font-semibold text-slate-700" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
    </div>

    <div>
      <%= form.label :password, class: "text-sm font-semibold text-slate-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "text-sm font-semibold text-slate-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
    </div>

    <%= form.submit "Create account", class: "min-h-12 w-full rounded-md bg-cyan-700 px-4 py-3 text-base font-bold text-white shadow-sm", data: { turbo_submits_with: "Creating account..." } %>

    <%= link_to "Already have an account? Sign in", new_session_path, class: "block py-2 text-center text-sm font-semibold text-slate-600 underline" %>
  <% end %>
</section>
<% end %>
