<section class="mx-auto max-w-2xl space-y-6 pt-6">
  <div>
    <p class="text-sm font-bold uppercase tracking-normal text-cyan-700">Two-factor authentication</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal text-slate-950">Save your recovery codes</h1>
    <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600">
      Each code can be used once if you lose access to your authenticator. Store them somewhere safe now;
      Boat Binder will not show these codes again.
    </p>
  </div>

  <div class="<%= app_card_class("p-5") %>">
    <ol class="grid gap-3 sm:grid-cols-2">
      <% @recovery_codes.each do |recovery_code| %>
        <li><code class="block rounded-md bg-slate-100 px-3 py-2 font-mono text-sm font-bold"><%= recovery_code %></code></li>
      <% end %>
    </ol>
  </div>

  <%= link_to "I saved my recovery codes", @continue_url, class: primary_button_class %>
</section>
