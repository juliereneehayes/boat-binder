<section class="mx-auto max-w-md pt-10">
  <div class="mb-8">
    <p class="text-sm font-bold uppercase tracking-normal text-cyan-700">Account setup</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal text-slate-950">Request a new verification email</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600">Enter the email used for registration. If it is eligible, we will send a new secure link.</p>
  </div>

  <%= form_with url: resend_email_verification_path, method: :post, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "text-sm font-semibold text-slate-700" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
        class: "mt-2 block min-h-12 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
    </div>

    <%= form.submit "Send verification email",
      class: "min-h-12 w-full rounded-md bg-cyan-700 px-4 py-3 text-base font-bold text-white shadow-sm",
      data: { turbo_submits_with: "Sending..." } %>

    <%= link_to "Return to sign in", new_session_path,
      class: "block py-2 text-center text-sm font-semibold text-slate-600 underline" %>
  <% end %>
</section>
