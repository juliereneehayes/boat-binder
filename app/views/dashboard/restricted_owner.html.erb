<section class="mx-auto max-w-2xl py-8 md:py-16">
  <div class="<%= app_card_class("p-6 text-center md:p-10") %>">
    <%= render "shared/brand_mark", class_name: "mx-auto h-16 w-16" %>
    <p class="mt-6 text-sm font-black uppercase tracking-normal text-[#1E5A7A]">Boat Binder</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal">Your binder is not available right now.</h1>
    <p class="mx-auto mt-4 max-w-lg text-sm leading-6 text-slate-600">
      Your account is still secure. Please contact an administrator if you believe you should have access.
    </p>

    <% if @self_managed_plans_available %>
      <%= link_to "View Self Managed plans", billing_checkout_path, class: primary_button_class("mt-6") %>
    <% end %>
  </div>
</section>
