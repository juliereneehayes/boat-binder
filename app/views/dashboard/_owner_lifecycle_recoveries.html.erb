<% visible_recoveries = recoveries.select(&:visible?) %>
<% if visible_recoveries.any? %>
  <section class="space-y-4" aria-label="Account recovery options">
    <% visible_recoveries.each do |recovery| %>
      <article class="<%= app_card_class("p-5 md:p-6") %>">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
          <div class="max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-sm font-black text-[#1E5A7A]"><%= recovery.account.name %></p>
              <%= status_chip(recovery.status_label, tone: :warning) %>
            </div>
            <h2 class="mt-3 text-2xl font-black tracking-normal"><%= recovery.title %></h2>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= recovery.description %></p>
            <% if recovery.date_label && recovery.date %>
              <p class="mt-3 text-sm font-bold text-slate-700">
                <%= recovery.date_label %>: <%= local_datetime(recovery.date, account: recovery.account) %>
              </p>
            <% end %>
          </div>

          <div class="flex w-full flex-col gap-2 lg:w-auto lg:min-w-64">
            <% if recovery.billing_portal_available? %>
              <%= button_to "Manage billing",
                billing_portal_path,
                params: { account_reference: recovery.account_reference },
                form: { data: { turbo: false } },
                class: primary_button_class("w-full") %>
            <% end %>

            <% if recovery.reactivation_available? %>
              <% Array(reactivation_options).each do |option| %>
                <%= button_to "Restart with #{option.interval == "month" ? "monthly" : "annual"}",
                  billing_reactivation_path,
                  params: {
                    option_key: option.key,
                    account_reference: recovery.account_reference
                  },
                  form: { data: { turbo: false } },
                  class: primary_button_class("w-full") %>
              <% end %>
            <% end %>

            <% if recovery.export_available? %>
              <% if open_export_request_account_ids.include?(recovery.account.id) %>
                <p class="rounded-md bg-[#F7F5F2] px-4 py-3 text-center text-sm font-bold text-slate-600">
                  Export request under review
                </p>
              <% else %>
                <%= button_to "Request an account export",
                  account_export_requests_path,
                  params: { account_reference: recovery.account_reference },
                  class: secondary_button_class("w-full") %>
              <% end %>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </section>
<% end %>
