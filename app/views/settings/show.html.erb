<section class="space-y-8">
  <div>
    <p class="text-sm font-black uppercase tracking-normal text-[#1E5A7A]">Your account</p>
    <h1 class="mt-2 text-3xl font-black tracking-normal">Settings</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Manage your profile, sign-in email, two-factor authentication, and active sessions.</p>
  </div>

  <section aria-labelledby="account-heading" class="space-y-5">
    <div>
      <p class="text-sm font-black uppercase tracking-normal text-[#1E5A7A]">Account</p>
      <h2 id="account-heading" class="mt-1 text-2xl font-black">Profile</h2>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <div class="<%= app_card_class("p-5") %>">
        <h3 class="text-lg font-black">Name</h3>
        <p class="mt-1 text-sm leading-6 text-slate-600">This is how your name appears throughout Boat Binder.</p>

        <%= field_error_messages(@user) %>
        <%= form_with model: @user, url: settings_path, method: :patch, class: "mt-5 space-y-4" do |form| %>
          <div>
            <%= form.label :name, class: "text-sm font-semibold text-slate-700" %>
            <%= form.text_field :name, maxlength: 120, autocomplete: "name",
              class: "mt-2 block min-h-11 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
          </div>
          <%= form.submit "Save name", class: primary_button_class, data: { turbo_submits_with: "Saving..." } %>
        <% end %>
      </div>

      <div class="<%= app_card_class("p-5") %>">
        <h3 class="text-lg font-black">Email address</h3>
        <p class="mt-1 text-sm leading-6 text-slate-600">Your verified email is used to sign in.</p>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-semibold text-slate-600">Current email</dt>
            <dd class="mt-1 font-black"><%= @user.email_address %></dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-600">Role</dt>
            <dd class="mt-1"><%= status_chip(role_label(@user), tone: :info) %></dd>
          </div>
          <% if @user.email_change_pending? %>
            <div>
              <dt class="font-semibold text-slate-600">Pending verification</dt>
              <dd class="mt-1 font-black"><%= @user.pending_email_address %></dd>
            </div>
          <% end %>
        </dl>

        <% if @email_change_error.present? %>
          <div class="mt-4 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
            <p><%= @email_change_error %></p>
          </div>
        <% end %>

        <%= form_with url: settings_email_change_path, scope: :email_change, class: "mt-5 space-y-4" do |form| %>
          <div>
            <%= form.label :email_address, "New email address", class: "text-sm font-semibold text-slate-700" %>
            <%= form.email_field :email_address, required: true, autocomplete: "email",
              value: @submitted_email_address,
              class: "mt-2 block min-h-11 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
          </div>
          <div>
            <%= form.label :current_password, "Current password", class: "text-sm font-semibold text-slate-700" %>
            <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "mt-2 block min-h-11 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
          </div>
          <%= form.submit "Send verification email", class: secondary_button_class,
            data: { turbo_submits_with: "Sending..." } %>
        <% end %>
      </div>
    </div>
  </section>

  <section id="security" aria-labelledby="security-heading" class="space-y-5 scroll-mt-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-black uppercase tracking-normal text-[#1E5A7A]">Security</p>
        <h2 id="security-heading" class="mt-1 text-2xl font-black">Security</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Protect your account and manage signed-in browsers and devices.</p>
      </div>
    </div>

    <div class="<%= app_card_class("p-5") %>">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-black">Two-factor authentication</h3>
          <% if @user.mfa_enrolled? %>
            <p class="mt-1 text-sm leading-6 text-slate-600">Enabled. <%= pluralize(@user.mfa_recovery_codes_remaining, "recovery code") %> remaining.</p>
          <% elsif @user.mfa_enrollment_pending? %>
            <p class="mt-1 text-sm leading-6 text-slate-600">Setup has not been confirmed yet.</p>
          <% else %>
            <p class="mt-1 text-sm leading-6 text-slate-600">
              Add a verification code from an authenticator or compatible password manager when you sign in.
            </p>
          <% end %>
        </div>

        <% if @user.mfa_enrollment_pending? %>
          <%= link_to "Continue setup", settings_mfa_enrollment_path, class: primary_button_class %>
        <% elsif !@user.mfa_enrolled? %>
          <%= button_to "Set up MFA", settings_mfa_enrollment_path, method: :post, class: primary_button_class %>
        <% end %>
      </div>

      <% if @user.mfa_enrolled? %>
        <div class="mt-6 grid gap-6 border-t border-slate-200 pt-6 lg:grid-cols-2">
          <%= form_with url: settings_mfa_recovery_codes_path, scope: :mfa,
            data: { turbo: false }, class: "space-y-3" do |form| %>
            <div>
              <h4 class="font-black">Regenerate recovery codes</h4>
              <p class="mt-1 text-sm text-slate-600">This invalidates every unused recovery code.</p>
            </div>
            <%= form.label :current_password, "Current password", class: "text-sm font-semibold text-slate-700" %>
            <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "block min-h-11 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
            <%= form.submit "Generate new recovery codes", class: secondary_button_class %>
          <% end %>

          <%= form_with url: settings_mfa_reenrollment_path, scope: :mfa, class: "space-y-3" do |form| %>
            <div>
              <h4 class="font-black">Replace authenticator</h4>
              <p class="mt-1 text-sm text-slate-600">This signs out every session and requires immediate MFA setup again.</p>
            </div>
            <%= form.label :current_password, "Current password", class: "text-sm font-semibold text-slate-700" %>
            <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "block min-h-11 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-700/20" %>
            <%= form.submit "Reset and re-enroll MFA", class: secondary_button_class,
              data: { turbo_confirm: "This will sign out every session and replace your current MFA setup.", turbo_submits_with: "Resetting..." } %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap items-end justify-between gap-4 pt-2">
      <div>
        <h3 class="text-xl font-black">Active Sessions</h3>
        <p class="mt-1 text-sm leading-6 text-slate-600">Browsers and devices currently signed in to your account.</p>
      </div>
      <% if @active_sessions.many? %>
        <%= button_to "Sign out other sessions", other_settings_sessions_path, method: :delete,
          class: primary_button_class %>
      <% end %>
    </div>

    <div class="space-y-3">
      <% @active_sessions.each do |active_session| %>
        <article class="<%= app_card_class("p-5") %>">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-black"><%= session_device_description(active_session) %></h3>
                <% if active_session == Current.session %>
                  <%= status_chip("Current session", tone: :success) %>
                <% end %>
              </div>
              <dl class="mt-3 grid gap-2 text-sm text-slate-600 sm:grid-cols-2 sm:gap-x-8">
                <div>
                  <dt class="font-semibold">Signed in</dt>
                  <dd><%= l active_session.created_at, format: :long %></dd>
                </div>
                <div>
                  <dt class="font-semibold">Recent activity</dt>
                  <dd><%= l active_session.last_seen_at, format: :long %></dd>
                </div>
              </dl>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</section>
